global
    log /dev/log local0
    maxconn 4000

defaults
    log     global
    mode    tcp
    timeout connect 10s
    timeout client  5m    # Increased for long-lived OTel gRPC streams
    timeout server  5m    # Increased for long-lived OTel gRPC streams
    timeout check   2s

frontend otlp_grpc
    bind *:4317
    default_backend otel_collectors

backend otel_collectors
    balance roundrobin
    

    # Swapped health checks to port 4317 to avoid noisy logs on the collectors
    {% for host in groups['otel_collector'] %}
    server {{ host }} {{ hostvars[host]['ansible_host'] }}:4317 check port 13133
    {% endfor %}
